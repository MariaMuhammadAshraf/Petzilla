@model IEnumerable<AptechVisionPetZilla.Models.Faq>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="custom-heading mb-4 text-center">Manage FAQs</h2>

<form method="post" asp-action="AddFaq" class="card shadow p-4">
    <input type="text" name="Question" placeholder="Enter Question" class="form-control mb-3" required />
    <textarea name="Answer" placeholder="Enter Answer" class="form-control mb-3" rows="3" required></textarea>
    <div class="text-center">
        <button type="submit" class="btn custom-btn px-4">Add FAQ</button>
    </div>
</form>

<table class="table mt-4 custom-table shadow-sm">
    <thead>
        <tr>
            <th>Question</th>
            <th>Answer</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var faq in Model)
        {
            <tr>
                <td>@faq.Question</td>
                <td>@faq.Answer</td>
                <td>
                    <a asp-action="EditFaq" asp-route-id="@faq.Id"
                       class="btn custom-btn-sm btn-info">
                        Edit
                    </a>
                    <a asp-action="DeleteFaq" asp-route-id="@faq.Id"
                       class="btn custom-btn-sm"
                       onclick="return confirm('Are you sure you want to delete this FAQ?');">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<style>
    /* ✅ Stylish Heading */
    .custom-heading {
        font-weight: 800;
        color: black;
        font-family: 'Poppins', 'Segoe UI', sans-serif;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    /* ✅ Gradient Buttons */
    .custom-btn {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black !important;
        font-weight: 500;
        border: none;
        border-radius: 6px;
        padding: 10px 24px;
        box-shadow: 0 4px 10px rgba(56, 249, 215, 0.4);
        transition: all 0.3s ease;
    }

        .custom-btn:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

    .custom-btn-sm {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black !important;
        border: none;
        border-radius: 4px;
        padding: 5px 12px;
        font-size: 13px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .custom-btn-sm:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    /* ✅ Table Style */
    .custom-table th {
        background-color: black;
        color: white;
        text-align: center;
    }

    .custom-table td {
        vertical-align: middle;
    }
</style>
