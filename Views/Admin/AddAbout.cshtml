@model AptechVisionPetZilla.Models.AboutSection
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="card shadow p-4">
    <!-- ✅ Updated Heading -->
    <h2 class="text-center mb-4 custom-heading">Add About Section</h2>

    <form asp-action="AddAbout" enctype="multipart/form-data" method="post">
        <div class="form-group mb-3">
            <label class="form-label">Title:</label>
            <input type="text" name="Title" class="form-control" placeholder="Enter title..." />
        </div>
        <div class="form-group mb-3">
            <label class="form-label">Description:</label>
            <textarea name="Description" class="form-control" placeholder="Enter description..." rows="4"></textarea>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Service Title:</label>
            <input type="text" name="ServiceTitle" class="form-control" placeholder="Enter service title..." />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Service Text:</label>
            <input type="text" name="ServiceText" class="form-control" placeholder="Enter service details..." />
        </div>

        <div class="form-group mb-4">
            <label class="form-label">Image:</label>
            <input type="file" name="ImageFile" class="form-control" />
        </div>

        <div class="text-center">
            <!-- ✅ Gradient Button -->
            <button type="submit" class="btn custom-btn px-4">Save</button>
        </div>
    </form>
</div>

<style>
    /* ✅ Gradient Theme Button */
    .custom-btn {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black !important;
        font-weight: 500;
        border: none;
        border-radius: 6px;
        padding: 10px 24px;
        box-shadow: 0 4px 10px rgba(56, 249, 215, 0.4);
        transition: all 0.3s ease;
    }

        .custom-btn:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

    /* ✅ Stylish Heading */
    .custom-heading {
        font-weight: 800;
        color: black;
        font-family: 'Poppins', 'Segoe UI', sans-serif;
        letter-spacing: 1px;
        text-transform: uppercase;
    }
</style>
