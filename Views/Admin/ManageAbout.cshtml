@model List<AptechVisionPetZilla.Models.AboutSection>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "About Us";
}


<h2 style="text-align:center; font-weight:bold;">@ViewData["Title"]</h2>

<!-- Gradient Theme Button -->
<a class="btn custom-btn mb-2" href="/Admin/AddAbout">Add About Section</a>

<table class="table custom-table">
    <tr>
        <th>Title</th>
        <th>Service</th>
        <th>Image</th>
        <th>Actions</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.ServiceTitle</td>
            <td><img src="@item.ImagePath" width="100" /></td>
            <td>
                <a href="@Url.Action("EditAbout", "Admin", new { id = item.Id })" class="btn custom-btn-sm">Edit</a>
                <a href="@Url.Action("DeleteAbout", "Admin", new { id = item.Id })"
                   class="btn custom-btn-sm"
                   onclick="return confirm('Are you sure you want to delete this section?');">
                    Delete
                </a>
            </td>
        </tr>
    }
</table>

<style>
    /* ✅ Gradient Button */
    .custom-btn {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black !important;
        font-weight: 500;
        border: none;
        border-radius: 6px;
        padding: 8px 18px;
        box-shadow: 0 4px 10px rgba(56, 249, 215, 0.4);
        transition: all 0.3s ease;
    }

        .custom-btn:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

    /* ✅ Small Buttons (Edit/Delete) */
    .custom-btn-sm {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black !important;
        border: none;
        border-radius: 4px;
        padding: 5px 12px;
        font-size: 13px;
        margin-right: 5px;
        transition: all 0.3s ease;
    }

        .custom-btn-sm:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    /* ✅ Table Header Style */
    .custom-table th {
        background-color: black;
        color: white;
        text-align: center;
    }

    .custom-table td {
        vertical-align: middle;
    }
</style>
