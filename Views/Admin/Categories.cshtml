@model IEnumerable<AptechVisionPetZilla.Models.PetCategory>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Pet Categories";
}

<h2 style="text-align:center; font-weight:bold;">@ViewData["Title"]</h2>

<a asp-action="AddCategory" class="btn custom-btn mb-3 text-black">+ Add New Category</a>

<table class="table custom-table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Action Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cat in Model)
        {
            <tr>
                <td>@cat.Id</td>
                <td>@cat.Name</td>
                <td>@cat.ActionName</td>
                <td>
                    <a asp-action="EditCategory" asp-route-id="@cat.Id" class="btn custom-btn-sm">Edit</a>
                    <a asp-action="DeleteCategory" asp-route-id="@cat.Id" class="btn custom-btn-sm" onclick="return confirm('Are you sure you want to delete this category?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<style>
    /* Add / main button */
    .custom-btn {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black !important;
        font-weight: 500;
        border: none;
        border-radius: 6px;
        padding: 8px 18px;
        box-shadow: 0 4px 10px rgba(56, 249, 215, 0.4);
        transition: all 0.3s ease;
    }

        .custom-btn:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

    /* Small buttons (Edit/Delete) */
    .custom-btn-sm {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black !important;
        border: none;
        border-radius: 4px;
        padding: 5px 12px;
        font-size: 13px;
        margin-right: 5px;
        transition: all 0.3s ease;
    }

        .custom-btn-sm:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    /* Table header */
    .custom-table th {
        background-color: black;
        color: white;
        text-align: center;
        font-weight: bold;
    }

    .custom-table td {
        vertical-align: middle;
    }
</style>
