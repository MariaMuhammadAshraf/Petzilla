@model AptechVisionPetZilla.Models.PetCategory

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Category";
}

<div class="card shadow p-4">
    <!-- ✅ Updated Heading -->
    <h2 class="text-center mb-4 custom-heading">@ViewData["Title"]</h2>

    <form asp-action="AddCategory" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Enter category name..." />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group mb-4">
            <label asp-for="ActionName" class="form-label"></label>
            <input asp-for="ActionName" class="form-control" placeholder="Enter action name..." />
            <span asp-validation-for="ActionName" class="text-danger"></span>
        </div>

        <div class="text-center">
            <!-- ✅ Gradient Save Button -->
            <button type="submit" class="btn custom-btn px-4">Save</button>
            <a asp-action="Categories" class="btn custom-btn px-4 ms-2">Back</a>
        </div>
    </form>
</div>

<style>
    /* ✅ Stylish Heading */
    .custom-heading {
        font-weight: 800;
        color: black;
        font-family: 'Poppins', 'Segoe UI', sans-serif;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    /* ✅ Gradient Theme Buttons */
    .custom-btn {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black !important;
        font-weight: 500;
        border: none;
        border-radius: 6px;
        padding: 10px 24px;
        box-shadow: 0 4px 10px rgba(56, 249, 215, 0.4);
        transition: all 0.3s ease;
        text-decoration: none;
    }

        .custom-btn:hover {
            opacity: 0.9;
            transform: translateY(-2px);
            text-decoration: none;
        }

    /* Card Form */
    .card {
        border-radius: 8px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        background-color: #fff;
    }
</style>
