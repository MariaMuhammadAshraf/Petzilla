<h2 class="text-center fw-bold mb-4">Manage Home Pets</h2>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Manage Pets</h2>
        <a asp-action="AddPet" class="btn custom-gradient-btn">
            <i class="fas fa-plus-circle me-1"></i> Add New Pet
        </a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Image</th>
                <th>Category</th>
                <th>Description</th>
                <th>Available</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var pet in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(pet.ImageUrl))
                            {
                                <img src="@pet.ImageUrl" alt="Pet Image" style="width: 80px; height: 80px; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="text-muted">No Image</span>
                            }
                        </td>
                        <td>@pet.Category</td>
                        <td>@pet.Description</td>
                        <td>
                            @if (pet.IsAvailable == true)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Adopted</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@pet.PetId" class="btn custom-gradient-btn-sm btn-sm mb-1">Edit</a>

                            <form asp-action="DeletePets" asp-controller="Admin" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@pet.PetId" />
                                <button type="submit" class="btn custom-gradient-btn-sm btn-sm"
                                        onclick="return confirm('Are you sure you want to delete this pet?');">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No home pets available.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    /* Gradient buttons */
    .custom-gradient-btn {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black;
        border: none;
        padding: 8px 18px;
        font-weight: bold;
        border-radius: 6px;
        transition: 0.3s;
        text-decoration: none;
    }

        .custom-gradient-btn:hover {
            background: linear-gradient(135deg, #38f9d7, #43e97b);
            color: #fff;
        }

    .custom-gradient-btn-sm {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black;
        border: none;
        font-weight: bold;
        border-radius: 6px;
        padding: 4px 12px;
        transition: 0.3s;
        text-decoration: none;
    }

        .custom-gradient-btn-sm:hover {
            background: linear-gradient(135deg, #38f9d7, #43e97b);
            color: #fff;
        }
</style>
