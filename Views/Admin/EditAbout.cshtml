@model AptechVisionPetZilla.Models.AboutSection
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="custom-heading mb-4 text-center">Edit About Section</h2>

<form asp-action="EditAbout" method="post" enctype="multipart/form-data" class="card shadow p-4">
    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="Enter title..." />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" placeholder="Enter description..." rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="form-label">Current Image:</label><br />
        <img src="@Url.Content(Model.ImagePath)" alt="Current Image" style="max-width: 200px; border-radius:6px; box-shadow:0 3px 8px rgba(0,0,0,0.2);" />
    </div>

    <div class="form-group mb-4">
        <label class="form-label">Upload New Image (optional):</label>
        <input type="file" name="ImageFile" class="form-control" />
    </div>

    <div class="text-center">
        <!-- ✅ Gradient Update Button -->
        <button type="submit" class="btn custom-btn px-4">Update</button>
    </div>
</form>

<style>
    /* ✅ Stylish Heading */
    .custom-heading {
        font-weight: 800;
        color: black;
        font-family: 'Poppins', 'Segoe UI', sans-serif;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    /* ✅ Gradient Theme Button */
    .custom-btn {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black !important;
        font-weight: 500;
        border: none;
        border-radius: 6px;
        padding: 10px 24px;
        box-shadow: 0 4px 10px rgba(56, 249, 215, 0.4);
        transition: all 0.3s ease;
    }

        .custom-btn:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }
</style>
