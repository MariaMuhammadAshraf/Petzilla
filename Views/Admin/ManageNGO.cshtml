@model IEnumerable<AptechVisionPetZilla.Models.Ngo>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage NGOs";
}

<div class="container py-5">
    <h2 class="section-title">Manage NGOs</h2>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success text-center mb-4">
            @TempData["success"]
        </div>
    }

    @if (!Model.Any())
    {
        <p class="text-center text-muted">No NGOs found.</p>
    }
    else
    {
        <table class="table  table-striped shadow-sm custom-table">
            <thead>
                <tr>
                    <th>NGO Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th>Branches</th>
                    <th>Availability</th>
                    <th>Status</th>
                    <th>Registered On</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ngo in Model)
                {
                    <tr>
                        <td>@ngo.NgoName</td>
                        <td>@ngo.Email</td>
                        <td>@ngo.PhoneNumber</td>
                        <td>@ngo.Address</td>
                        <td>@ngo.Branches</td>
                        <td>
                            <span class="badge @(ngo.AvailabilityStatus ? "bg-success" : "bg-danger")">
                                @(ngo.AvailabilityStatus ? "Available" : "Not Available")
                            </span>
                        </td>
                        <td>@ngo.Status</td>
                        <td>@ngo.CreatedAt.ToString("dd MMM yyyy")</td>

                        <td>
                            <div style="display:inline-flex; gap:8px;">

                                @* Approve only for pending NGOs *@
                                @if (ngo.Status.ToLower() == "pending")
                                {
                                    <form asp-action="ApproveNGO" method="post" style="margin:0;">
                                        <input type="hidden" name="id" value="@ngo.NgoId" />
                                        <button type="submit" class="custom-btn-sm mb-1">Approve</button>
                                    </form>
                                }

                                @* Edit button *@
                                <a asp-action="EditNGO" asp-route-id="@ngo.NgoId" class="custom-btn-sm mb-1">
                                    Edit
                                </a>

                                @* Delete button *@
                                <form asp-action="DeleteNGO" method="post" style="margin:0;">
                                    <input type="hidden" name="id" value="@ngo.NgoId" />
                                    <button type="submit" class="custom-btn-sm mb-1"
                                            onclick="return confirm('Are you sure you want to delete this NGO?');">
                                        Delete
                                    </button>
                                </form>

                            </div>
                        </td>



                    </tr>
                }
            </tbody>
        </table>
    }
</div>
<style>
    /* Heading */
    .section-title {
        text-align: center;
        font-weight: bold;
        font-size: 26px;
        margin-bottom: 1.5rem;
    }

    /* Badge */
    .badge {
        font-size: 0.85rem;
        padding: 0.4em 0.7em;
    }

    table.table {
        background: #fff;
    }

        table.table th, table.table td {
            vertical-align: middle;
        }

    /* Table header */
    .custom-table th {
        background-color: black;
        color: white;
        text-align: center;
        font-weight: bold;
        font-size: 14px;
    }

    /* Gradient Main Button */
    .custom-btn {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black !important;
        font-weight: 600;
        border: none;
        border-radius: 6px;
        padding: 8px 18px;
        box-shadow: 0 4px 10px rgba(56, 249, 215, 0.4);
        transition: all 0.3s ease;
    }

        .custom-btn:hover {
            background: linear-gradient(135deg, #38f9d7, #43e97b);
            transform: translateY(-2px);
            opacity: 0.95;
        }

    /* Small Gradient Buttons */
    .custom-btn-sm {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black !important;
        border: none;
        border-radius: 4px;
        padding: 5px 12px;
        font-size: 13px;
        margin-right: 5px;
        transition: all 0.3s ease;
    }

        .custom-btn-sm:hover {
            background: linear-gradient(135deg, #38f9d7, #43e97b);
            transform: translateY(-1px);
            opacity: 0.95;
        }
</style>