@model AptechVisionPetZilla.Models.UserRegistration
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Register";
}
 


@if (ViewBag.RegistrationSuccess != null && ViewBag.RegistrationSuccess == true) 
 { 
    <div class="alert alert-success alert-dismissible fade show" role="alert"> 
       Registration successful! You can now log in. 
         <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button> 
     </div> 
 }

<section class="ftco-appointment ftco-section ftco-no-pt ftco-no-pb position-relative"
         style="width: 100vw;
                min-height: 100vh;
                overflow: hidden;
                margin-left: calc(-50vw + 50%);
                margin-right: calc(-50vw + 50%);
                padding-top: 100px;   /* More top space */
                padding-bottom: 100px; /* More bottom space */
                background: #fff;">

    <div class="overlay"
         style="background: linear-gradient(135deg, rgba(67,233,123,0.15), rgba(56,249,215,0.15));
                position:absolute; top:0; left:0; right:0; bottom:0;"></div>

    <div class="container d-flex justify-content-center position-relative">
        <div class="col-md-6 col-lg-5">

            <div class="shadow-lg rounded-4 p-5 mt-4 mb-4"
                 style="background: rgba(255, 255, 255, 0.08);
                        backdrop-filter: blur(14px);
                        border: 1.5px solid rgba(67,233,123,0.4);
                        color: #fff;">

                <h3 class="mb-4 text-center fw-bold"
                    style="color:#000; letter-spacing:1px; text-shadow:0px 1px 2px rgba(255,255,255,0.4);">
                    Register
                </h3>

                <form asp-controller="Home" asp-action="Register" method="post">
                    <div class="mb-3">
                        <label asp-for="FirstName" class="form-label">First Name</label>
                        <input asp-for="FirstName" class="form-control rounded-3 border-0 shadow-sm px-3 py-2"
                               style="background: rgba(255,255,255,0.9);" placeholder="Enter your first name" />
                        <span asp-validation-for="FirstName" class="text-warning small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LastName" class="form-label">Last Name</label>
                        <input asp-for="LastName" class="form-control rounded-3 border-0 shadow-sm px-3 py-2"
                               style="background: rgba(255,255,255,0.9);" placeholder="Enter your last name" />
                        <span asp-validation-for="LastName" class="text-warning small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">User Name</label>
                        <input asp-for="UserName" class="form-control rounded-3 border-0 shadow-sm px-3 py-2"
                               style="background: rgba(255,255,255,0.9);" placeholder="Choose a username" />
                        <span asp-validation-for="UserName" class="text-warning small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UserEmail" class="form-label">Email</label>
                        <input asp-for="UserEmail" type="email" class="form-control rounded-3 border-0 shadow-sm px-3 py-2"
                               style="background: rgba(255,255,255,0.9);" placeholder="Enter your email" />
                        <span asp-validation-for="UserEmail" class="text-warning small"></span>
                    </div>

                    <div class="mb-3"> 
                        <label asp-for="UserPassword" class="form-label">Password</label> 
                        <input asp-for="UserPassword" type="password" class="form-control rounded-3 border-0 shadow-sm px-3 py-2" 
                               style="background: rgba(255,255,255,0.9);" placeholder="Create a password" /> 
                         <span asp-validation-for="UserPassword" class="text-warning small"></span> 
                     </div>
                      <div class="d-grid">
                        <button type="submit" class="btn register-btn text-black fw-bold shadow"
                                style="background: linear-gradient(135deg, #43e97b, #38f9d7);
                                       border: 2px solid #38f9d7;
                                       padding: 10px 20px;
                                       border-radius:50px;">
                            Register
                        </button>
                    </div>

                    <div class="text-center mt-3 text-black">
                        <small>Already have an account? <a asp-controller="Home" asp-action="Login">Log in</a></small>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>
 



<!-- Custom CSS -->
<style>
    .register-btn {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        border-radius: 30px;
        padding: 10px 0;
        font-size: 16px;
        color: black;
        font-weight: 600;
        border: none;
        transition: all 0.4s ease-in-out;
        box-shadow: 0 4px 10px rgba(67, 233, 123, 0.25);
    }

        .register-btn:hover {
            background: linear-gradient(135deg, #38f9d7, #43e97b); /* reverse gradient */
            transform: translateY(-3px) scale(1.03); /* smooth lift */
            box-shadow: 0 6px 18px rgba(56, 249, 215, 0.45), 0 0 10px rgba(67, 233, 123, 0.35); /* glow */
            letter-spacing: 0.5px; /* elegant text spacing */
        }

    /* Shine effect overlay */
        .register-btn::after {
        content: "";
        position: absolute;
        top: 0;
        left: -75%;
        width: 50%;
        height: 100%;
        background: rgba(255, 255, 255, 0.3);
        transform: skewX(-25deg);
        transition: left 0.6s ease;
        z-index: -1;
    }

        .register-btn:hover::after {
        left: 125%;
    }

   

</style>
 
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
 
