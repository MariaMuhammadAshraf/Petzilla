@section Styles {
    <style>
        /* 🌐 Toggle Button */
        #chat-toggle {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: linear-gradient(135deg, #43e97b, #38f9d7);
            color: black;
            padding: 12px 20px;
            font-weight: 700;
            border-radius: 30px;
            cursor: pointer;
            font-size: 14px;
            box-shadow: 0 6px 14px rgba(0,0,0,0.25);
            transition: all 0.3s ease-in-out;
            z-index: 1000;
        }

            #chat-toggle:hover {
                transform: scale(1.08);
                box-shadow: 0 8px 18px rgba(0,0,0,0.35);
            }

        /* 💬 Chat Box (Glassmorphism) */
        #chat-box {
            display: none;
            flex-direction: column;
            position: fixed;
            bottom: 80px;
            right: 20px;
            width: 340px;
            max-height: 520px;
            background: rgba(30, 30, 47, 0.8);
            backdrop-filter: blur(12px);
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 0 25px rgba(0,0,0,0.4);
            z-index: 1001;
            font-family: 'Segoe UI', sans-serif;
        }

        /* 🐾 Header */
        #chat-header {
            background: linear-gradient(135deg, #43e97b, #38f9d7);
            padding: 12px 15px;
            font-weight: 800;
            color: black;
            font-size: 15px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.25);
        }

        /* 📜 Chat History */
        #chatHistory {
            flex: 1;
            overflow-y: auto;
            padding: 12px;
            background: transparent;
            height: 320px;
            scrollbar-width: thin;
            scrollbar-color: #43e97b #2c2c3b;
        }

        /* ✏️ Input */
        #chat-input {
            display: flex;
            padding: 10px;
            border-top: 1px solid rgba(255,255,255,0.1);
            background: rgba(30,30,47,0.7);
            backdrop-filter: blur(10px);
        }

            #chat-input textarea {
                flex: 1;
                resize: none;
                border-radius: 10px;
                padding: 8px 10px;
                border: none;
                background-color: rgba(44,44,59,0.8);
                color: white;
                font-size: 14px;
            }

                #chat-input textarea::placeholder {
                    color: #bbb;
                }

            #chat-input button {
                margin-left: 6px;
                padding: 8px 18px;
                border: none;
                background: linear-gradient(135deg, #43e97b, #38f9d7);
                color: black;
                border-radius: 10px;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.3s ease-in-out;
                box-shadow: 0 4px 10px rgba(0,0,0,0.25);
            }

                #chat-input button:hover {
                    transform: scale(1.05);
                    box-shadow: 0 6px 14px rgba(0,0,0,0.35);
                }

        /* 💌 Messages */
        .message {
            margin: 8px 0;
            padding: 10px 14px;
            border-radius: 18px;
            max-width: 75%;
            clear: both;
            word-wrap: break-word;
            font-size: 14px;
            line-height: 1.4;
        }

        .user-message {
            background: linear-gradient(135deg, #43e97b, #38f9d7);
            color: black;
            float: right;
            text-align: right;
            border-bottom-right-radius: 5px;
            font-weight: 600;
            box-shadow: 0 2px 6px rgba(0,0,0,0.25);
        }

        .assistant-message {
            background: rgba(255,255,255,0.1);
            color: white;
            float: left;
            text-align: left;
            border-bottom-left-radius: 5px;
            backdrop-filter: blur(6px);
            box-shadow: 0 2px 6px rgba(0,0,0,0.25);
        }
    </style>
}

