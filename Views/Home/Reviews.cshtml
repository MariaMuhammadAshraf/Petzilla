@model IEnumerable<AptechVisionPetZilla.Models.Review>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Client Reviews";
}
<section class="hero-wrap hero-wrap-2"
         style="background-image: url('@Url.Content("~/images/bg_2.jpg")');
                background-size: cover;
                background-position: center center;
                background-repeat: no-repeat;
                width: 100vw;
                margin-left: calc(-50vw + 50%);
                margin-right: calc(-50vw + 50%);
                overflow: hidden;"
         data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-end">
            <div class="col-md-9 ftco-animate pb-5">
                <p class="breadcrumbs justify-content-center mb-0">
                    <span class="mr-2"><a asp-controller="Home" asp-action="Index">Home <i class="ion-ios-arrow-forward"></i></a></span>
                    <span>Reviews<i class="ion-ios-arrow-forward"></i></span>
                </p>
                <h1 class="mb-0 bread">Reviews</h1>
            </div>
        </div>
    </div>
</section>
<section class="ftco-section testimony-section"
         style="width: 100vw; overflow:hidden; margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); background-image:url('@Url.Content("~/images/bg_2.jpg")'); position: relative;">

    <div class="overlay" style="position: absolute; inset: 0; background: rgba(0,0,0,0.5); z-index: 1;"></div>

    <div class="container" style="position: relative; z-index: 2;">
        <div class="row justify-content-center pb-5 mb-3">
            <div class="col-md-7 heading-section text-center ftco-animate text-white">
                <h2>Happy Clients &amp; Feedbacks</h2>
            </div>
        </div>

        @if (!Model.Any())
        {
            <p class="text-center text-white">No reviews found.</p>
        }
        else
        {
            <div class="row">
                @foreach (var review in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 review-card text-center">
                            @if (!string.IsNullOrEmpty(review.ImageUrl))
                            {
                                <img src="@Url.Content(review.ImageUrl)" class="review-img mx-auto mt-3" alt="@review.Name" />
                            }
                            else
                            {
                                <img src="@Url.Content("~/images/default-user.png")" class="review-img mx-auto mt-3" alt="Default User" />
                            }
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title fw-bold">@review.Name</h5>
                                <h6 class="card-subtitle mb-2 text-muted">@review.Position</h6>
                                <p class="card-text flex-grow-1">"@review.Text"</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- ✅ Always visible Submit Review Button (Bottom) -->
        <div class="text-center my-3">
            <a href="@Url.Action("SubmitReview", "Home")" class="btn-gradient">
                Submit Your Review
            </a>
        </div>
    </div>
</section>
 
<style>
    .btn-gradient {
        border-radius: 10px;
        font-size: 22px; /* text thora bada */
        padding: 16px 32px; /* height aur width dono barh gaye */
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black;
        font-weight: 900;
        box-shadow: 0 4px 12px rgba(56, 249, 215, 0.4);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        display: inline-block;
        text-decoration: none;
    }

        .btn-gradient:hover {
            transform: translateY(-3px) scale(1.05); /* hover pe thora zoom */
            box-shadow: 0 8px 18px rgba(56, 249, 215, 0.6);
        }

    /* Review Card */
    .review-card {
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.15); /* glass effect */
        backdrop-filter: blur(12px);
        border: 6px solid rgba(67, 233, 123, 0.6);
       
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .review-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(56, 249, 215, 0.3);
            border: 5px solid rgba(255, 255, 255, 0.2);
        }

    /* Review Image */
    .review-img {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid transparent;
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        padding: 3px;
        box-shadow: 0 4px 12px rgba(56, 249, 215, 0.4);
    }

    .card-title {
        font-size: 1.5rem;
        font-weight: 900;
        color: black;
    }

    .card-subtitle {
        font-size: 0.95rem;
        font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
        color: black;
        font-weight: 900;
    }

    .card-text {
        font-size: 1.3rem;
        font-weight: 900;
        font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
        color: black;
        font-style: italic;
    }

</style>
