@model IEnumerable<AptechVisionPetZilla.Models.Faq>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Home Page";
}
<section class="hero-wrap hero-wrap-2"
         style="background-image: url('@Url.Content("~/images/bg_2.jpg")');
                background-size: cover;
                background-position: center center;
                background-repeat: no-repeat;
                width: 100vw;
                margin-left: calc(-50vw + 50%);
                margin-right: calc(-50vw + 50%);
                overflow: hidden;"
         data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-end">
            <div class="col-md-9 ftco-animate pb-5">
                <p class="breadcrumbs justify-content-center mb-0">
                    <span class="mr-2">
                        <a asp-controller="Home" asp-action="Index">Home <i class="ion-ios-arrow-forward"></i></a>
                    </span>
                    <span>FAQs <i class="ion-ios-arrow-forward"></i></span>
                </p>
                <h1 class="mb-0 bread">FAQs</h1>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section bg-light ftco-faqs">
    <div class="container">
        <div class="row">
            <!-- Left Column -->
            <div class="col-lg-6 order-md-last">
                <div class="img img-video d-flex align-self-stretch align-items-center justify-content-center justify-content-md-center mb-4 mb-sm-0" style="background-image:url(/images/about.jpg);">
                    <a href="https://vimeo.com/45830194" class="icon-video popup-vimeo d-flex justify-content-center align-items-center">
                        <span class="fa fa-play"></span>
                    </a>
                </div>
                <div class="d-flex mt-3">
                    <div class="img img-2 mr-md-2" style="background-image:url(/images/about-2.jpg);"></div>
                    <div class="img img-2 ml-md-2" style="background-image:url(/images/about-3.jpg);"></div>
                </div>
            </div>

            <!-- Right Column -->
            <div class="col-lg-6">
                <div class="heading-section mb-5 mt-5 mt-lg-0">
                    <h2 class="mb-3">Frequently Asked Questions</h2>
                    <p>Find answers to the most common pet-related questions below.</p>
                </div>

                <div class="accordion w-100" id="faqAccordion">
                    @{
                        int index = 1;
                    }
                    @foreach (var item in Model)
                    {
                        string collapseId = "collapse" + index;
                        string headingId = "heading" + index;
                        bool isFirst = index == 1;
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="@headingId">
                                <button class="accordion-button @(isFirst ? "" : "collapsed")"
                                        type="button"
                                        data-mdb-toggle="collapse"
                                        data-mdb-target="#@collapseId"
                                        aria-expanded="@(isFirst.ToString().ToLower())"
                                        aria-controls="@collapseId">
                                    @item.Question
                                </button>
                            </h2>
                            <div id="@collapseId"
                                 class="accordion-collapse collapse @(isFirst ? "show" : "")"
                                 aria-labelledby="@headingId"
                                 data-mdb-parent="#faqAccordion">
                                <div class="accordion-body">
                                    @Html.Raw(item.Answer)
                                </div>
                            </div>
                        </div>
                        index++;
                    }
                </div>




             


            </div>
        </div>
    </div>
</section>
<style>
    /* Accordion Button Gradient */
    .accordion-button {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black;
        font-weight: 600;
        border: none;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(56, 249, 215, 0.3);
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .accordion-button.collapsed {
            background: linear-gradient(135deg, #38f9d7, #43e97b);
        }

        .accordion-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(56, 249, 215, 0.5);
        }

        .accordion-button:focus {
            box-shadow: 0 0 0 0.25rem rgba(56, 249, 215, 0.5);
            outline: none;
        }

    /* Accordion Body */
    .accordion-body {
        background: #f0fdf8; /* light greenish background */
        color: #000;
        font-size: 15px;
        line-height: 1.6;
        border-radius: 0 0 8px 8px;
        margin-top: 2px;
        padding: 16px;
    }

    /* Accordion Item Spacing */
    .accordion-item {
        margin-bottom: 15px;
        border-radius: 8px;
        overflow: hidden;
        border: none;
    }

</style>