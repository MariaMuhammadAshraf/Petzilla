@{

    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Home Page";
 
   
}
<!-- END nav -->
<section class="hero-wrap hero-wrap-2"
         style="background-image: url('@Url.Content("~/images/bg_2.jpg")');
                background-size: cover;
                background-position: center center;
                background-repeat: no-repeat;
                width: 100vw;
                margin-left: calc(-50vw + 50%);
                margin-right: calc(-50vw + 50%);
                overflow: hidden;"
         data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-end">
            <div class="col-md-9 ftco-animate pb-5">
                <p class="breadcrumbs justify-content-center mb-0">
                    <span class="mr-2"><a asp-controller="Home" asp-action="Index">Home <i class="ion-ios-arrow-forward"></i></a></span>
                    <span>About us <i class="ion-ios-arrow-forward"></i></span>
                </p>
                <h1 class="mb-0 bread">About Us</h1>
            </div>
        </div>
    </div>
</section>
<style>
    html, body {
        overflow-x: hidden;
    }
</style>
@model List<AptechVisionPetZilla.Models.AboutSection>
@foreach (var about in Model)
{
    // Dynamically assign icon class
    string iconClass;

    if (!string.IsNullOrEmpty(about.IconClass))
    {
        iconClass = about.IconClass;
    }
    else if (!string.IsNullOrEmpty(about.Title))
    {
        switch (about.Title.ToLower())
 
        {
            case "our mission":
                iconClass = "fas fa-paw"; // 🐾 Mission: Helping stray & home pets
                break;
            case "our vision":
                iconClass = "fas fa-binoculars"; // 👀 Vision: Finding families for pets
                break;
            case "why choose us":
                iconClass = "fas fa-heart"; // ❤️ Love & care for animals
                break;
            case "what we do":
                iconClass = "fas fa-dog"; // 🐶 Work with pets directly
                break;
            case "our goal":
                iconClass = "fas fa-cat"; // 🐱 Goal: Safe adoption for cats & dogs
                break;
            default:
                iconClass = "fas fa-info-circle"; // ℹ Professional fallback for About Us
                break;
        }


    }
    else
    {
        iconClass = "fa-solid fa-address-card"; // fallback if everything is null
    }

    <section class="ftco-section py-5 px-4">
        <div class="container">
            <div class="row align-items-center bg-light rounded shadow-sm p-4">

                <!-- IMAGE SECTION -->
                <div class="col-md-5 mb-4 mb-md-0">
                    <div class="img img-video d-flex align-items-center justify-content-center rounded shadow"
                         style="background-image:url('@Url.Content(about.ImagePath)'); height: 300px; background-size: cover; background-position: center;">
                    </div>
                </div>

                <!-- TEXT SECTION -->
                <div class="col-md-7">
                    <div class="heading-section mb-4">
                        <h2 class="text-primary fw-bold">@about.Title</h2>
                        <p class="text-muted">@about.Description</p>
                    </div>

                    <!-- SERVICE INFO -->
                    <div class="d-flex align-items-start">
                        <div class="icon me-3">
                            <i class="@iconClass fs-2 text-success mx-2 my-2   "></i>
                        </div>
                        <div>
                            <h5 class="fw-semibold">@about.ServiceTitle</h5>
                            <p>@about.ServiceText</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>
}



<section class="ftco-section bg-light">
    <div class="container">
        <div class="row mb-5 pb-5">
            <div class="col-md-4 d-flex align-self-stretch px-4 ftco-animate">
                <div class="d-block services text-center">
                    <div class="icon d-flex align-items-center justify-content-center">
                        <span class="fa fa-paw"   <span class="fa fa-heart" style="font-size: 40px; color:lightgrey; text-shadow: 2px 2px 3px rgba(0,0,0,0.4);"></span></span>
                    </div>
                    <div class="media-body p-4">
                        <h3 class="heading">Pet Adoption</h3>
                        <p>Find loving homes for stray and home pets through our safe and verified adoption process.</p>
                        <a href="#" class="btn-custom d-flex align-items-center justify-content-center"><span class="fa fa-chevron-right"></span><i class="sr-only">Read more</i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 d-flex align-self-stretch px-4 ftco-animate">
                <div class="d-block services text-center">
                    <div class="icon d-flex align-items-center justify-content-center">
                        <span class="fa fa-heart"   <span class="fa fa-heart" style="font-size: 40px; color:lightgrey; text-shadow: 2px 2px 3px rgba(0,0,0,0.4);"></span></span>
                    </div>
                    <div class="media-body p-4">
                        <h3 class="heading">Foster & Care</h3>
                        <p>Provide temporary care for pets while helping them wait for their forever home.</p>
                        <a href="#" class="btn-custom d-flex align-items-center justify-content-center"><span class="fa fa-chevron-right"></span><i class="sr-only">Read more</i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 d-flex align-self-stretch px-4 ftco-animate">
                <div class="d-block services text-center">
                    <div class="icon d-flex align-items-center justify-content-center">
                        <span class="fa fa-scissors"   <span class="fa fa-heart" style="font-size: 40px; color:lightgrey; text-shadow: 2px 2px 3px rgba(0,0,0,0.4);"></span></span>
                    </div>
                    <div class="media-body p-4">
                        <h3 class="heading">Pet Grooming</h3>
                        <p>Professional grooming services to keep pets happy, clean, and healthy.</p>
                        <a href="#" class="btn-custom d-flex align-items-center justify-content-center"><span class="fa fa-chevron-right"></span><i class="sr-only">Read more</i></a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-5 pt-4">
            <div class="col-md-4 d-flex align-self-stretch px-4 ftco-animate">
                <div class="d-block services text-center">
                    <div class="icon d-flex align-items-center justify-content-center">
                        <span class="fa fa-stethoscope"   <span class="fa fa-heart" style="font-size: 40px; color:lightgrey; text-shadow: 2px 2px 3px rgba(0,0,0,0.4);"></span></span>
                    </div>
                    <div class="media-body p-4">
                        <h3 class="heading">Veterinary Support</h3>
                        <p>Access to professional veterinary guidance for your pets’ health and wellness.</p>
                        <a href="#" class="btn-custom d-flex align-items-center justify-content-center"><span class="fa fa-chevron-right"></span><i class="sr-only">Read more</i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 d-flex align-self-stretch px-4 ftco-animate">
                <div class="d-block services text-center">
                    <div class="icon d-flex align-items-center justify-content-center">
                        <span class="fa fa-bone"   <span class="fa fa-heart" style="font-size: 40px; color:lightgrey; text-shadow: 2px 2px 3px rgba(0,0,0,0.4);"></span></span>
                    </div>
                    <div class="media-body p-4">
                        <h3 class="heading">Pet Feeding</h3>
                        <p>Guidance and resources for proper nutrition and diet plans for your pets.</p>
                        <a href="#" class="btn-custom d-flex align-items-center justify-content-center"><span class="fa fa-chevron-right"></span><i class="sr-only">Read more</i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 d-flex align-self-stretch px-4 ftco-animate">
                <div class="d-block services text-center">
                    <div class="icon d-flex align-items-center justify-content-center">
                        <span class="fa fa-comments"   <span class="fa fa-heart" style="font-size: 40px; color:lightgrey; text-shadow: 2px 2px 3px rgba(0,0,0,0.4);"></span></span>
                    </div>
                    <div class="media-body p-4">
                        <h3 class="heading">Pet Consultation</h3>
                        <p>Expert advice and consultations for behavioral, health, and care concerns of your pets.</p>
                        <a href="#" class="btn-custom d-flex align-items-center justify-content-center"><span class="fa fa-chevron-right"></span><i class="sr-only">Read more</i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>





<style>
    /* Services Card */
    .services {
        background: #ffffff;
        border-radius: 15px;
        padding: 30px 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

        .services:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(56, 249, 215, 0.3);
        }

    
        /* Icon Style */
        .services .icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            margin: 0 auto 20px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            background: linear-gradient(135deg, #43e97b, #38f9d7);
            color: white;
            box-shadow: 0 8px 25px rgba(56, 249, 215, 0.5); /* stronger shadow */
            border: 3px solid #38f9d7; /* add border around icon */
            transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        }

        /* Optional: Hover effect for icons */
        .services:hover .icon {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(56, 249, 215, 0.7); /* bigger shadow on hover */
            border-color: #43e97b; /* change border color on hover */
        }


        /* Heading */
        .services .heading {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 15px;
            background: linear-gradient(135deg, #43e97b, #38f9d7);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Paragraph */
        .services p {
            font-size: 14px;
            color: #555;
            margin-bottom: 20px;
        }

    /* Read More Button */
    .btn-custom {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        text-decoration: none;
    }

        .btn-custom:hover {
            transform: scale(1.2);
            box-shadow: 0 10px 25px rgba(56, 249, 215, 0.5);
        }

        .btn-custom .fa-chevron-right {
            font-size: 16px;
        }
    /* Container Card Gradient Background */
    .ftco-section .bg-light.rounded.shadow-sm {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(56, 249, 215, 0.3);
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .ftco-section .bg-light.rounded.shadow-sm:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(56, 249, 215, 0.5);
        }

    /* Title Gradient */
    .heading-section h2 {
        background: linear-gradient(135deg, #38f9d7, #43e97b);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 700;
    }

    /* Service Icon Gradient Circle */
    .icon i {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        padding: 10px;
        border-radius: 50%;
        font-size: 2.5rem;
    }

    /* Paragraph Styling */
    .ftco-section p {
        color: #000;
        opacity: 0.85;
    }

    /* Service Title */
    .d-flex h5.fw-semibold {
        color: black;
        font-weight: 600;
    }


</style>