<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center pb-5 mb-3">
            <div class="col-md-7 heading-section text-center ftco-animate">
                <h2>Home Pets</h2>
            </div>
        </div>
        <div class="row">
            @if (Model != null && Model.Any())
            {
                foreach (var pet in Model)
                {
                    <div class="col-md-4 mb-4 ftco-animate">
                        <div class="pet-card-wrapper">
                            <div class="pet-card">
                                <img src="@pet.ImageUrl" alt="@pet.PetName" class="pet-image" />
                                <div class="p-3 pet-info">
                                    <h5>@pet.PetName</h5>
                                    <p class="text-muted mb-1">@pet.Category</p>
                                    <p class="small">@pet.Description</p>
                                    <p>
                                        @if (pet.IsAvailable == true)
                                        {
                                            <span class="badge bg-success">Available</span>
                                        }
                                        else if (pet.IsAvailable == false)
                                        {
                                            <span class="badge bg-danger">Adopted</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Unknown</span> <!-- fallback if null -->
                                        }
                                    </p>
                                </div>
                                <div class="p-3">
                                    <a asp-controller="Home" asp-action="RequestForHome" asp-route-id="@pet.PetId"
                                       class="btn custom-gradient-btn w-100 @(pet.IsAvailable == true ? "" : "disabled")">
                                        Adoption Request
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted">
                    <h4>No pets available at the moment.</h4>
                </div>
            }
        </div>
    </div>
</section>

<style>
    /* PET CARD */
    .pet-card {
        background: rgba(255, 255, 255, 0.15); /* subtle glass effect */
        backdrop-filter: blur(12px);
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
        transition: transform 0.35s ease, box-shadow 0.35s ease;
        height: auto;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        max-width: 330px;
        margin: auto;
        border: 1px solid rgba(56, 249, 215, 0.15); /* soft border */
    }

        /* Card Hover */
        .pet-card:hover {
            transform: translateY(-8px) scale(1.03);
            box-shadow: 0 14px 28px rgba(56, 249, 215, 0.35);
            border: 1px solid rgba(67, 233, 123, 0.4);
        }

    /* PET IMAGE */
    .pet-image {
        width: 100%;
        height: 210px;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    /* Subtle zoom on hover */
    .pet-card:hover .pet-image {
        transform: scale(1.05);
    }

    /* PET INFO */
    .pet-info h5 {
        font-size: 1.3rem;
        font-weight: 800;
        margin-bottom: 6px;
        color: #222;
    }

    .pet-info p {
        font-size: 0.92rem;
        color: #444;
    }

    /* Compact Gradient Button */
    .custom-gradient-btn {
        border-radius: 10px;
        font-size: 0.9rem; /* 👈 text size chhoti */
        font-weight: 700;
        padding: 8px 16px; /* 👈 button compact */
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        border: none;
        color: #111 !important;
        transition: all 0.35s ease;
        box-shadow: 0 4px 10px rgba(56, 249, 215, 0.3);
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

        .custom-gradient-btn:hover {
            background: linear-gradient(135deg, #38f9d7, #43e97b); /* 👈 hover pe reverse */
            box-shadow: 0 6px 14px rgba(56, 249, 215, 0.4);
        }


        /* Hover Effect - shiny animation */
        .custom-gradient-btn:hover:not(.disabled) {
            background: linear-gradient(135deg, #38f9d7, #43e97b);
            transform: translateY(-4px) scale(1.06);
            box-shadow: 0 10px 25px rgba(56, 249, 215, 0.55);
            color: #000 !important;
        }

        /* Shine effect overlay */
        .custom-gradient-btn::after {
            content: "";
            position: absolute;
            top: 0;
            left: -75%;
            width: 50%;
            height: 100%;
            background: rgba(255, 255, 255, 0.3);
            transform: skewX(-25deg);
            transition: left 0.6s ease;
            z-index: -1;
        }

        .custom-gradient-btn:hover::after {
            left: 125%;
        }

    /* Disabled State */
    .btn.disabled,
    .btn:disabled {
        opacity: 0.6;
        color: dimgrey;
        cursor: not-allowed;
        background: #ccc !important;
        box-shadow: none;
        transform: none !important;
    }

    /* BADGES */
    .badge {
        font-size: 0.85rem;
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 8px;
    }

        .badge.bg-success {
            background: linear-gradient(135deg, #43e97b, #38f9d7);
            color: #111;
            box-shadow: 0 2px 6px rgba(56, 249, 215, 0.25);
        }

        .badge.bg-danger {
            background: linear-gradient(135deg, #ff6a6a, #ff3d3d);
            color: #fff;
            box-shadow: 0 2px 6px rgba(255, 0, 0, 0.25);
        }

        .badge.bg-secondary {
            background: linear-gradient(135deg, #9e9e9e, #757575);
            color: #fff;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
        }


</style>
