@model IEnumerable<AptechVisionPetZilla.Models.Pet>

@{
    ViewData["Title"] = "Home Pets";
}
@{
    var userRole = User.FindFirst("UserRole")?.Value?.ToLower(); // use lowercase for consistency
    var isCustomer = userRole == "customer";
}


<section class="hero-wrap hero-wrap-2"
         style="background-image: url('@Url.Content("~/images/bg_2.jpg")');
                background-size: cover;
                background-position: center center;
                background-repeat: no-repeat;
                width: 100vw;
                margin-left: calc(-50vw + 50%);
                margin-right: calc(-50vw + 50%);
                overflow: hidden;"
         data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-end">
            <div class="col-md-9 ftco-animate pb-5">
                <p class="breadcrumbs justify-content-center mb-0">
                    <span class="mr-2">
                        <a asp-controller="Home" asp-action="Index">Home <i class="ion-ios-arrow-forward"></i></a>
                    </span>
                    <span>Home Pets <i class="ion-ios-arrow-forward"></i></span>
                </p>
                <h1 class="mb-0 bread">Home Pets</h1>
            </div>
        </div>
    </div>
</section>

<style>
    html, body {
        overflow-x: hidden;
    }

    .pet-card {
        border: 1px solid #ddd;
        border-radius: 10px;
        overflow: hidden;
        transition: transform 0.3s ease-in-out;
        background: #fff;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .pet-card:hover {
            transform: translateY(-5px);
            box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.15);
        }

    .pet-image {
        height: 250px;
        object-fit: cover;
        width: 100%;
    }

    .pet-info {
        flex-grow: 1;
    }
</style>

