<section class="ftco-appointment ftco-section ftco-no-pt ftco-no-pb position-relative"
         style="width: 100vw;
                min-height: 100vh;
                overflow: hidden;
                margin-left: calc(-50vw + 50%);
                margin-right: calc(-50vw + 50%);
                padding-top: 100px;
                padding-bottom: 100px;
                background: #fff;">

    <!-- 🌿 Soft Transparent Overlay -->
    <div class="overlay"
         style="background: linear-gradient(135deg, rgba(67,233,123,0.15), rgba(56,249,215,0.15));
                position:absolute; top:0; left:0; right:0; bottom:0;"></div>

    <div class="container d-flex justify-content-center position-relative">
        <div class="col-md-6 col-lg-5">

            <!-- 🌟 Glassmorphism Card -->
            <div class="shadow-lg rounded-4 p-5 mt-4 mb-4"
                 style="background: rgba(255, 255, 255, 0.08);
                        backdrop-filter: blur(14px);
                        border: 1.5px solid rgba(67,233,123,0.4);
                        color: #fff;">


                    <div class="card-body p-4">
                        <h3 class="mb-4 text-center fw-bold"
                            style="color:#111; text-shadow: 1px 1px 2px rgba(0,0,0,0.1);">
                            Change Password
                        </h3>

                        @if (TempData["error"] != null)
                        {
                            <div class="alert alert-danger text-center rounded-3 shadow-sm">@TempData["error"]</div>
                        }
                        @if (TempData["success"] != null)
                        {
                            <div class="alert alert-success text-center rounded-3 shadow-sm">@TempData["success"]</div>
                        }

                        <form asp-action="ChangePassword" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="CurrentPassword" class="form-label fw-semibold">Current Password</label>
                                <input asp-for="CurrentPassword" type="password" class="form-control rounded-3 shadow-sm border-0" placeholder="Enter current password" />
                                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewPassword" class="form-label fw-semibold">New Password</label>
                                <input asp-for="NewPassword" type="password" class="form-control rounded-3 shadow-sm border-0" placeholder="Enter new password" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm New Password</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control rounded-3 shadow-sm border-0" placeholder="Confirm new password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <div class="d-grid">

                                <button type="submit"
                                    class="btn gradient-btn rounded-pill py-2 text-black fw-bold shadow"
                                        style="background: linear-gradient(135deg, #43e97b, #38f9d7); border: none;">
                                    Change Password
                                </button>

                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- ✅ Reusable Gradient Button -->
<style>
    /* Gradient button base style */
    .gradient-btn {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        border: none;
        font-weight: 600; /* bold text */
        color: black;
        transition: all 0.3s ease-in-out;
    }

        /* Hover effect with darker gradient */
        .gradient-btn:hover {
            background: linear-gradient(135deg, #38f9d7, #43e97b);
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 6px 18px rgba(56, 249, 215, 0.45), 0 0 10px rgba(67, 233, 123, 0.35);
            letter-spacing: 0.5px;
            color: #000;
        }
    /* Shine effect overlay */
        .gradient-btn::after {
        content: "";
        position: absolute;
        top: 0;
        left: -75%;
        width: 50%;
        height: 100%;
        background: rgba(255, 255, 255, 0.3);
        transform: skewX(-25deg);
        transition: left 0.6s ease;
        z-index: -1;
    }

        .gradient-btn::after {
        left: 125%;
    }

</style>
