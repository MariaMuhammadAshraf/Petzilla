@model IEnumerable<AptechVisionPetZilla.Models.Ngo>
@{
    ViewData["Title"] = "NGOs Overview";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
}

<section class="ngos-overview py-5 position-relative"
         style="background:#fff; width:100vw; margin-left:calc(-50vw + 50%); margin-right:calc(-50vw + 50%);">

    <!-- 🌿 Soft Gradient Overlay -->
    <div class="overlay"
         style="background: linear-gradient(135deg, rgba(67,233,123,0.12), rgba(56,249,215,0.12));
                position:absolute; top:0; left:0; right:0; bottom:0; z-index:0;">
    </div>

    <div class="container position-relative" style="z-index:1;">
        <h2 class="text-center mb-3 fw-bold"
            style="color:black; text-shadow:0px 1px 2px rgba(0,0,0,0.6);">
            Our Partner NGOs
        </h2>

        @if (TempData["success"] != null)
        {
            <div class="alert alert-success text-center mb-4">
                @TempData["success"]
            </div>
        }

        @if (!Model.Any())
        {
            <p class="text-center text-muted">No NGOs registered yet.</p>
        }
        else
        {
            <!-- 🌟 Glassmorphism Table Wrapper -->
            <div class="table-responsive shadow-lg rounded-4 p-4"
                 style="background: rgba(255, 255, 255, 0.08);
                        backdrop-filter: blur(14px);
                        border: 1.5px solid rgba(67,233,123,0.4);">

                <table class="table align-middle mb-0" style="color:#000;">
                    <thead style="background:black; color:white; text-align:center; font-size:12px;">
                        <tr>
                            <th>NGO Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Address</th>
                            <th>Branches</th>
                            <th>Availability</th>
                            <th>Status</th>
                            <th>Registered On</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var ngo in Model)
                        {
                            <tr style="background: rgba(255,255,255,0.6); border-radius:12px; transition:all 0.3s;">
                                <td>@ngo.NgoName</td>
                                <td>@ngo.Email</td>
                                <td>@ngo.PhoneNumber</td>
                                <td>@ngo.Address</td>
                                <td>@ngo.Branches</td>
                                <td>
                                    <span class="badge @(ngo.AvailabilityStatus ? "bg-success" : "bg-danger")">
                                        @(ngo.AvailabilityStatus ? "Available" : "Not Available")
                                    </span>
                                </td>
                                <td>@ngo.Status</td>
                                <td>@ngo.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    <a asp-action="NgoDetails" asp-route-id="@ngo.NgoId"
                                       class="btn btn-gradient rounded-1 btn-sm px-3 fw-bold">View Details</a>



                                    @if (isAdmin && ngo.Status == "Pending")
                                    {
                                        <form asp-action="ApproveNGO" method="post" class="d-inline-block w-100">
                                            <input type="hidden" name="id" value="@ngo.NgoId" />
                                            <button type="submit" class="btn btn-sm form-btn w-100">
                                                Approve
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<style>
    /* Gradient buttons */
    .form-btn {
        border-radius: 15px;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 6px 12px;
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        border: none;
        color: #111 !important;
        transition: all 0.35s ease;
        box-shadow: 0 4px 10px rgba(56, 249, 215, 0.3);
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

        .form-btn:hover {
            background: linear-gradient(135deg, #38f9d7, #43e97b);
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 6px 15px rgba(56, 249, 215, 0.45), 0 0 8px rgba(67, 233, 123, 0.35);
            color: #000;
        }

    
    .badge {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        font-size: 0.75rem;
        color: #000;
        padding: 0.35em 0.65em;
    }
</style>
