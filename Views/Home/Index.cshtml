@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    Layout = "~/Views/Shared/_Layout.cshtml";
   
}
<div class="hero-wrap js-fullheight"
     style="background-image: url('@Url.Content("~/images/banner.png")');
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            overflow:hidden;
            width: 100vw;
            margin-left: calc(-50vw + 50%);
            margin-right: calc(-50vw + 50%);"
     data-stellar-background-ratio="0.5">


    <div class="overlay"></div>

    <div class="d-flex align-items-center justify-content-center text-center" style="height: 100vh; width: 100%;">
        <div class="col-md-11 ftco-animate text-white">

            <h1 class="mb-4" style="
    font-size: 2.5rem;
    font-weight: 700;
    color: #1a1a1a; /* deep neutral for professionalism */
    line-height: 1.3;
    max-width: 700px; /* keep text readable */
    margin: 0 auto; /* center for banner */
    text-align: center;
    letter-spacing: 0.5px;
">
                Connecting Stray & Home Pets with Loving Families<br />
                You Can Trust
            </h1>



            <p>
                <a href="@Url.Action("About", "Home")"
                   class="btn custom-gradient-btn mr-md-4 py-3 px-4">
                    Learn More <span class="ion-ios-arrow-forward"></span>
                </a>


            </p>
        </div>
    </div>
</div>

<section class="ftco-section bg-light ftco-no-pt ftco-intro">
    <div class="container">
        <div class="row">

            <div class="col-md-4 d-flex align-self-stretch px-4 ftco-animate">
                <div class="d-block services text-center shadow-sm rounded p-4 theme-service">
                    <div class="icon d-flex align-items-center justify-content-center mb-3">
                        <span class="fa fa-paw"
                              style="font-size: 40px; color:lightgrey; text-shadow: 2px 2px 3px rgba(0,0,0,0.4);">
                        </span>

                    </div>
                    <div class="media-body">
                        <h3 class="heading text-black fw-semibold">Pet Adoption</h3>
                        <p>Find loving homes for stray and home pets through our safe and verified adoption process.</p>
                        <a href="/" class="btn btn-gradient btn-sm mt-2">
                            Read More <span class="fa fa-chevron-right"></span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4 d-flex align-self-stretch px-4 ftco-animate">
                <div class="d-block services text-center shadow-sm rounded p-4 theme-service">
                    <div class="icon d-flex align-items-center justify-content-center mb-3">
                        <span class="fa fa-heart" style="font-size: 40px; color:lightgrey; text-shadow: 2px 2px 3px rgba(0,0,0,0.4);"></span>
                    </div>
                    <div class="media-body">
                        <h3 class="heading">Foster & Care</h3>
                        <p>Provide temporary care for pets while helping them wait for their forever home.</p>
                        <a href="/" class="btn btn-gradient btn-sm mt-2">
                            Read More <span class="fa fa-chevron-right"></span>
                        </a>
                    </div>
                </div>
            </div>


            <div class="col-md-4 d-flex align-self-stretch px-4 ftco-animate">
                <div class="d-block services text-center shadow-sm rounded p-4 theme-service">
                    <div class="icon d-flex align-items-center justify-content-center mb-3">
                        <span class="fa fa-stethoscope"   <span class="fa fa-heart" style="font-size: 40px; color:lightgrey; text-shadow: 2px 2px 3px rgba(0,0,0,0.4);"></span></span>
                    </div>
                    <div class="media-body">
                        <h3 class="heading">Health & Support</h3>
                        <p>Access veterinary guidance and health support to ensure the well-being of adopted pets.</p>
                        <a href="/" class="btn btn-gradient btn-sm mt-2">
                            Read More <span class="fa fa-chevron-right"></span>
                        </a>
                    </div>
                </div>
            </div>



        </div>
    </div>
</section>


<style>
   
    /* Icon Style */
        .theme-service .icon{
        width: 60px;
        height: 60px;
        border-radius: 50%;
        margin: 0 auto 20px auto;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black;
        box-shadow: 0 8px 25px rgba(56, 249, 215, 0.5); /* stronger shadow */
        border: 3px solid #38f9d7; /* add border around icon */
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    /* Optional: Hover effect for icons */
        .theme-service .icon {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(56, 249, 215, 0.7); /* bigger shadow on hover */
        border-color: #43e97b; /* change border color on hover */
    }

    /* Optional: Hover effect for icons */
    .services:hover .icon {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(56, 249, 215, 0.7); /* bigger shadow on hover */
        border-color: #43e97b; /* change border color on hover */
    }

    .btn-gradient {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        border-radius: 6px;
        color: black;
        font-weight: 500;
        font-size: 12px;
        padding: 4px 10px;
        border: 2px solid transparent;
        transition: all 0.2s;
    }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 12px rgba(56, 249, 215, 0.6);
            border: 2px solid #38f9d7;
        }
</style>


<section class="ftco-section ftco-no-pt ftco-no-pb">
    <div class="container">
        <div class="row d-flex no-gutters">
            <div class="col-md-5 d-flex">
                <div class="img img-video d-flex align-self-stretch align-items-center justify-content-center justify-content-md-center mb-4 mb-sm-0"
