<style>
    /* Theme Testimony Card with Gradient Border & Hover Effect */
    .theme-testimony-card {
        background: rgba(255, 255, 255, 0.08); /* Glass effect */
        backdrop-filter: blur(12px);
        border-radius: 25px;
        padding: 30px 20px;
        margin: 10px;
        border: 6px solid rgba(67, 233, 123, 0.6); /* Strong gradient-like border */
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease, border 0.3s ease;
        color: black;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

        .theme-testimony-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(56, 249, 215, 0.3);
            border: 5px solid rgba(255, 255, 255, 0.2);
        }

    /* User Image with Gradient Border & Hover Zoom */
    .user-img {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background-size: cover;
        background-position: center;
        border: 4px solid transparent;
        background-origin: border-box;
        background-clip: content-box, border-box;
        background-image: linear-gradient(#fff,#fff), linear-gradient(135deg, #43e97b, #38f9d7);
        box-shadow: 0 4px 12px rgba(56, 249, 215, 0.4);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        margin-bottom: 15px;
    }

        .user-img:hover {
            transform: scale(1.05) translateY(-2px);
            box-shadow: 0 8px 18px rgba(56, 249, 215, 0.6);
        }

    /* Icon & Text */
    .icon {
        font-size: 36px;
        margin-bottom: 15px;
    }

    .gradient-text {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .theme-testimony-card p {
        font-size: 1rem;
        line-height: 1.6;
        text-align: center;
        color: black;
    }

    .name {
        font-weight: 700;
        font-size: 1.1rem;
        margin: 5px 0 0 0;
        color: black;
    }

    .position {
        font-size: 0.9rem;
        color: black;
        font-weight: 500;
    }
</style>


