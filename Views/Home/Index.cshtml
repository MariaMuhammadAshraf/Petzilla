    }

        .icon-video:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(56, 249, 215, 0.5);
        }

    .img.img-2 {
        width: 48%;
        height: 100px;
        background-size: cover;
        background-position: center;
    }
</style>




  
