        </div>
    </div>
</section>




<section class="ftco-counter bg-light py-5" id="section-counter"
         style="width: 100vw; overflow:hidden; margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%);">
    <div class="container-fluid px-0">
        <div class="row no-gutters justify-content-center">

            <div class="col-md-6 col-lg-3 d-flex justify-content-center counter-wrap ftco-animate">
                <div class="counter-card text-center shadow-sm rounded p-4 mx-2">
                    <div class="number gradient-text" data-number="120">0</div>
                    <div class="label">Pets Adopted</div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3 d-flex justify-content-center counter-wrap ftco-animate">
                <div class="counter-card text-center shadow-sm rounded p-4 mx-2">
                    <div class="number gradient-text" data-number="75">0</div>
                    <div class="label">Active Volunteers</div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3 d-flex justify-content-center counter-wrap ftco-animate">
                <div class="counter-card text-center shadow-sm rounded p-4 mx-2">
                    <div class="number gradient-text" data-number="200">0</div>
                    <div class="label">Pets Rescued</div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3 d-flex justify-content-center counter-wrap ftco-animate">
                <div class="counter-card text-center shadow-sm rounded p-4 mx-2">
                    <div class="number gradient-text" data-number="95">0</div>
                    <div class="label">Families Connected</div>
                </div>
            </div>

        </div>
    </div>
</section>


<style>
    .counter-card {
        background: #ffffff;
        border-radius: 12px;
        padding: 20px 10px;
        width: 100%;
        max-width: 180px;
        transition: transform 0.3s, box-shadow 0.3s, border 0.3s;
        border: 2px solid transparent; /* initial border */
        box-shadow: 0 4px 12px rgba(56, 249, 215, 0.25); /* subtle shadow */
    }

        .counter-card:hover {
            transform: translateY(-5px);
            box-shadow: 3px 10px 25px rgba(56, 249, 215, 0.35); /* stronger shadow */
            border-image-slice: 1;
            border-width: 2px;
            border-style: solid;
            border-image-source: linear-gradient(135deg, #43e97b, #38f9d7); /* gradient outline */
        }

    .number {
        font-size: 35px;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .gradient-text {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .label {
        font-size: 16px;
        color: #555;
        font-weight: 900;
    }

</style>



<section class="ftco-section bg-light ftco-faqs">
    <div class="container">
        <div class="row">
            <!-- Images -->
            <div class="col-lg-6 order-md-last">
                <div class="img img-video d-flex align-self-stretch align-items-center justify-content-center justify-content-md-center mb-4 mb-sm-0 rounded shadow"
                     style="background-image:url('@Url.Content("~/images/about.jpg")'); background-size: cover; background-position: center;">
                    <a href="https://vimeo.com/45830194"
                       class="icon-video popup-vimeo d-flex justify-content-center align-items-center">
                        <span class="fa fa-play"></span>
                    </a>
                </div>
                <div class="d-flex mt-3">
                    <div class="img img-2 mr-md-2 rounded shadow" style="background-image:url('@Url.Content("~/images/about-2.jpg")');"></div>
                    <div class="img img-2 ml-md-2 rounded shadow" style="background-image:url('@Url.Content("~/images/about-3.jpg")');"></div>
                </div>
            </div>

            <!-- FAQ Content -->
            <div class="col-lg-6">
                <div class="heading-section mb-5 mt-5 mt-lg-0">
                    <h2 class="mb-3">Frequently Asked Questions</h2>
                    <p>Quick answers to common questions about pet adoption, fostering, and care.</p>
                </div>

                <div id="accordion" class="myaccordion w-100" aria-multiselectable="true">
                    <div class="card theme-faq-card">
                        <div class="card-header p-0" id="headingOne">
                            <h2 class="mb-0">
                                <button class="faq-btn d-flex py-3 px-4 align-items-center justify-content-between"
                                        data-mdb-toggle="collapse"
                                        data-mdb-target="#collapseOne"
                                        aria-expanded="true"
                                        aria-controls="collapseOne"
                                        data-mdb-parent="#accordion">
                                    <p class="mb-0">How can I adopt a pet from PetZilla?</p>
                                    <i class="fa fa-chevron-down"></i>
                                </button>
                            </h2>
                        </div>
                        <div class="collapse show" id="collapseOne" role="tabpanel" aria-labelledby="headingOne">
                            <div class="card-body py-3 px-0">
                                <ol>
                                    <li>Browse our list of available pets on the website.</li>
                                    <li>Fill out the adoption request form with your details.</li>
                                    <li>Our team will review your application and connect you with the pet.</li>
                                    <li>Schedule a visit or meeting to meet your potential pet.</li>
                                    <li>Complete the adoption process with guidance from PetZilla.</li>
                                </ol>
                            </div>
                        </div>
                    </div>

                    <div class="card theme-faq-card">
                        <div class="card-header p-0" id="headingTwo">
                            <h2 class="mb-0">
                                <button class="faq-btn d-flex py-3 px-4 align-items-center justify-content-between collapsed"
                                        data-mdb-toggle="collapse"
                                        data-mdb-target="#collapseTwo"
                                        aria-expanded="false"
                                        aria-controls="collapseTwo"
                                        data-mdb-parent="#accordion">
                                    <p class="mb-0">How do I foster a pet temporarily?</p>
                                    <i class="fa fa-chevron-down"></i>
                                </button>
                            </h2>
                        </div>
                        <div class="collapse" id="collapseTwo" role="tabpanel" aria-labelledby="headingTwo">
                            <div class="card-body py-3 px-0">
                                <ol>
                                    <li>Sign up as a foster caregiver on PetZilla.</li>
                                    <li>Choose a pet that matches your lifestyle and home environment.</li>
                                    <li>Receive guidance and support from our team during the foster period.</li>
                                    <li>Ensure the pet's health, feeding, and social needs are met.</li>
                                    <li>Help the pet transition smoothly to its permanent home.</li>
                                </ol>
                            </div>
                        </div>
                    </div>

                    <div class="card theme-faq-card">
                        <div class="card-header p-0" id="headingThree">
                            <h2 class="mb-0">
                                <button class="faq-btn d-flex py-3 px-4 align-items-center justify-content-between collapsed"
                                        data-mdb-toggle="collapse"
                                        data-mdb-target="#collapseThree"
                                        aria-expanded="false"
                                        aria-controls="collapseThree"
                                        data-mdb-parent="#accordion">
                                    <p class="mb-0">What support does PetZilla provide after adoption?</p>
                                    <i class="fa fa-chevron-down"></i>
                                </button>
                            </h2>
                        </div>
                        <div class="collapse" id="collapseThree" role="tabpanel" aria-labelledby="headingThree">
                            <div class="card-body py-3 px-0">
                                <ol>
                                    <li>Access to veterinary guidance and health tips.</li>
                                    <li>Follow-up support for any behavioral or care concerns.</li>
                                    <li>Community support through forums and adoption events.</li>
                                    <li>Resources for training, feeding, and pet wellness.</li>
                                    <li>Continued advice to ensure a smooth transition for pets into their new homes.</li>
                                </ol>
                            </div>
                        </div>
                    </div>

                    <!-- Add more FAQs as needed -->
                </div>
            </div>
        </div>
    </div>
</section>


<style>
    .theme-faq-card {
        background: #ffffff;
        border-radius: 12px;
        margin-bottom: 10px;
        box-shadow: 0 4px 12px rgba(56, 249, 215, 0.2);
        border: 2px solid transparent;
        transition: all 0.3s;
    }

        .theme-faq-card:hover {
            box-shadow: 0 10px 25px rgba(56, 249, 215, 0.35);
            border-image-slice: 1;
            border-width: 2px;
            border-style: solid;
            border-image-source: linear-gradient(135deg, #43e97b, #38f9d7);
        }

    .faq-btn {
        background: linear-gradient(135deg, #43e97b, #38f9d7);
        color: black;
        font-weight: 500;
        font-size: 14px;
        border-radius: 8px;
        border: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        transition: all 0.3s;
    }

        .faq-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(56, 249, 215, 0.4);
        }

        .faq-btn i {
            transition: transform 0.3s;
        }

        .faq-btn.collapsed i {
            transform: rotate(0deg);
        }

        .faq-btn:not(.collapsed) i {
            transform: rotate(180deg);
        }

    .icon-video {
        width: 60px;
        height: 60px;
        border-radius: 50%;
