    <style>
        #chatBox, #chatHistory, .message, #userInput {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
    </style>

    <script>
        // Toggle chat box
        document.getElementById('chatToggleBtn').addEventListener('click', function () {
            const box = document.getElementById('chatBox');

            if (box.style.display === 'none' || box.style.display === '') {
                // ✅ Fresh open: clear previous messages
                document.getElementById("chatHistory").innerHTML = "";

                // ✅ Show greeting message from PetZilla
                appendMessage("👋 Welcome to PetZilla! How can we help you today?", false);

                box.style.display = 'flex';
            } else {
                box.style.display = 'none';
            }
        });

        // Close button
        document.getElementById('closeChat').addEventListener('click', function () {
            document.getElementById('chatBox').style.display = 'none';
        });

        // Append chat messages
        function appendMessage(content, isUser) {
            const div = document.createElement("div");
            div.className = "message " + (isUser ? "user-message" : "assistant-message");
            div.innerText = content;
            div.style.marginBottom = "10px";
            div.style.padding = "10px 15px";
            div.style.borderRadius = "20px";
            div.style.maxWidth = "75%";
            div.style.wordWrap = "break-word";
            div.style.alignSelf = isUser ? "flex-end" : "flex-start";
            div.style.backgroundColor = isUser ? "#007bff" : "#343a40";
            div.style.color = "white";

            const history = document.getElementById("chatHistory");
            history.appendChild(div);
            div.scrollIntoView({ behavior: "smooth" });
        }

        // Show typing indicator
        function showTyping() {
            const div = document.createElement("div");
            div.className = "message assistant-message typing";
            div.id = "typingIndicator";
            div.innerText = "PetZilla is typing...";
            div.style.marginBottom = "10px";
            div.style.padding = "10px 15px";
            div.style.borderRadius = "20px";
            div.style.maxWidth = "75%";
            div.style.wordWrap = "break-word";
            div.style.alignSelf = "flex-start";
            div.style.backgroundColor = "#343a40";
            div.style.color = "white";
            div.style.fontStyle = "italic";

            const history = document.getElementById("chatHistory");
            history.appendChild(div);
            div.scrollIntoView({ behavior: "smooth" });
        }

        // Remove typing indicator
        function removeTyping() {
            const typingDiv = document.getElementById("typingIndicator");
            if (typingDiv) typingDiv.remove();
        }

        // Send message
        function sendMessage() {
            const inputBox = document.getElementById("userInput");
            const message = inputBox.value.trim();
            if (!message) return;

            appendMessage(message, true);
            inputBox.value = "";

            // ✅ Show typing indicator
            showTyping();

            fetch('/Home/GetResponse', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: message })
            })
            .then(res => res.json())
            .then(data => {
                // ✅ Remove typing indicator before showing response
                removeTyping();
                appendMessage(data.response, false);
            })
            .catch(error => {
                removeTyping();
                appendMessage("Error: " + error, false);
            });
        }

        // Send message on Enter key
        document.getElementById("userInput").addEventListener("keypress", function(e) {
            if (e.key === "Enter") sendMessage();
        });
    </script>


</body>



